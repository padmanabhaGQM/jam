{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jam/state.schema.json",
  "title": "jam run state",
  "description": "On-disk source of truth for a jam run. The gate hook reads this; the model cannot forge a passed gate.",
  "type": "object",
  "required": ["runId", "phase", "gates", "dial", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string" },
    "topic": { "type": "string" },
    "phase": { "enum": ["DIAGNOSE", "VERIFY", "ALIGN", "PLAN", "SPRINT", "FINISH"] },
    "currentSprint": { "type": ["integer", "null"], "minimum": 0 },
    "createdAt": { "type": "string" },
    "mode": { "enum": ["repair", "greenfield"] },
    "goalRef": { "type": ["string", "null"] },
    "goalSource": { "type": ["string", "null"] },
    "codexSessionIds": {
      "type": "object",
      "description": "Codex session ids for resume, keyed by purpose (e.g. sprint index).",
      "additionalProperties": { "type": "string" }
    },
    "artifacts": {
      "type": "object",
      "description": "Relative paths to durable artifacts.",
      "additionalProperties": { "type": "string" }
    },
    "gates": {
      "type": "object",
      "description": "Gate id -> status.",
      "additionalProperties": {
        "type": "object",
        "required": ["mode", "status"],
        "properties": {
          "mode": { "enum": ["human", "show-and-proceed", "auto"] },
          "status": { "enum": ["pending", "rendered", "verified", "planned", "evidence-passed", "approved", "rejected"] },
          "approvedBy": { "type": ["string", "null"] },
          "approvedAt": { "type": ["string", "null"] },
          "evidenceRef": { "type": ["string", "null"] },
          "approveFrom": { "enum": ["rendered", "verified", "planned"] }
        }
      }
    },
    "dial": {
      "type": "object",
      "description": "Per-gate mode overrides; distrust-heavy defaults applied when absent.",
      "additionalProperties": { "enum": ["human", "show-and-proceed", "auto"] }
    },
    "coverage": {
      "type": "array",
      "description": "Spec/plan pointers that must each be hit.",
      "items": {
        "type": "object",
        "required": ["id", "text", "status"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "status": { "enum": ["open", "addressed", "dropped"] }
        }
      }
    },
    "steeringDirectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "status", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "context": { "type": "string" },
          "status": { "enum": ["active", "satisfied"] },
          "createdAt": { "type": "string" }
        }
      }
    },
    "runaway": {
      "type": "object",
      "description": "Bounded-exchange / cost counters per phase for the runaway guard.",
      "additionalProperties": { "type": "number" }
    },
    "plan": {
      "type": "object",
      "properties": {
        "verifyCmd": { "type": "string" },
        "sprints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "acceptanceCriteria": { "type": "string" },
              "status": { "enum": ["pending", "in-progress", "done"] }
            }
          }
        }
      }
    }
  }
}
